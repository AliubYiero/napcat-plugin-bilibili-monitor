{
    "name": "napcat-plugin-bilibili-monitor",
    "plugin": "Bilibili监测者",
    "description": "监听指定用户动态发布/视频发布/直播状态, 推送到指定群聊",
    "version": "1.0.0",
    "type": "module",
    "main": "index.mjs",
    "author": "Yiero",
    "license": "MIT",
    "keywords": [
        "napcat",
        "plugin",
        "qq",
        "template"
    ],
    "napcat": {
        "tags": [
            "工具",
            "消息",
            "推送"
        ],
        "minVersion": "4.14.0",
        "homepage": "https://github.com/AliubYiero/napcat-plugin-bilibili-monitor"
    },
    "dependencies": {
        "napcat-types": "0.0.16"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@types/express": "^5.0.6",
        "@types/node": "^20.19.33",
        "napcat-plugin-debug-cli": "^1.2.8",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "ws": "^8.19.0"
    },
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "build:webui": "cd src/webui && pnpm install && pnpm run build",
        "dev:webui": "cd src/webui && pnpm run dev",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write"
    }
}
